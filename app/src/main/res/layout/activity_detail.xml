<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hình ảnh sản phẩm -->
        <ImageView
            android:id="@+id/imgItem"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:layout_marginBottom="12dp" />

        <!-- Tiêu đề -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp" />

        <!-- Mô tả -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp" />

        <!-- Giá -->
        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <!-- Trạng thái đã bán -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sản phẩm đã bán"
            android:textColor="@color/red"
            android:textStyle="bold"
            android:visibility="gone"
            android:paddingTop="4dp"
            android:layout_marginBottom="8dp" />

        <!-- Trạng thái đề nghị của tôi -->
        <TextView
            android:id="@+id/tvMyOfferStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp" />

        <!-- Nút đề nghị giá -->
        <Button
            android:id="@+id/btnOffer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đề nghị giá"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp" />

        <!-- Nút chỉnh sửa bài đăng (người bán) -->
        <Button
            android:id="@+id/btnEditItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chỉnh sửa bài đăng"
            android:visibility="gone"
            android:layout_marginBottom="8dp"
            android:textColor="@color/black" />

        <!-- Nút đánh giá -->
        <Button
            android:id="@+id/btnRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đánh giá"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp" />

        <!-- Nút mua ngay -->
        <Button
            android:id="@+id/btnBuyNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mua ngay"
            android:textColor="@color/white"
            android:backgroundTint="@color/black"
            android:layout_marginBottom="16dp" />

        <!-- Danh sách các đề nghị giá (chỉ người bán thấy) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerOffers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>
