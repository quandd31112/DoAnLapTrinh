<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:showDividers="middle"
        android:dividerPadding="8dp"
        android:divider="?android:attr/dividerVertical">

        <!-- Ảnh sản phẩm -->
        <ImageView
            android:id="@+id/itemImageView"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:layout_marginBottom="12dp"
            android:background="@drawable/image_border"
            android:contentDescription="Ảnh sản phẩm" />

        <Button
            android:id="@+id/selectImageButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chọn ảnh (tối đa 10)"
            android:textColor="@color/black"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/white"
            android:background="@drawable/btn_white_border" />

        <!-- Tiêu đề -->
        <EditText
            android:id="@+id/itemTitleEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tiêu đề sản phẩm"
            android:padding="12dp"
            android:background="@drawable/edittext_bg"
            android:layout_marginBottom="12dp" />

        <!-- Mô tả -->
        <EditText
            android:id="@+id/itemDescriptionEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mô tả sản phẩm"
            android:minLines="3"
            android:gravity="top"
            android:padding="12dp"
            android:background="@drawable/edittext_bg"
            android:layout_marginBottom="12dp" />

        <!-- Tags -->
        <EditText
            android:id="@+id/itemTagsEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tags (ngăn cách bằng dấu phẩy)"
            android:padding="12dp"
            android:background="@drawable/edittext_bg"
            android:layout_marginBottom="12dp" />

        <!-- Giá -->
        <EditText
            android:id="@+id/itemPriceEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Giá (VNĐ)"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:background="@drawable/edittext_bg"
            android:layout_marginBottom="12dp" />

        <!-- Vĩ độ -->
        <EditText
            android:id="@+id/latitudeEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Vĩ độ (Latitude)"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:background="@drawable/edittext_bg"
            android:layout_marginBottom="12dp" />

        <!-- Kinh độ -->
        <EditText
            android:id="@+id/longitudeEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Kinh độ (Longitude)"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:background="@drawable/edittext_bg"
            android:layout_marginBottom="12dp" />

        <!-- Nút lấy vị trí GPS -->
        <Button
            android:id="@+id/getLocationButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lấy vị trí GPS"
            android:textColor="@color/black"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@android:color/darker_gray" />

        <!-- Hành động -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/previewButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xem trước"
                android:textColor="@color/black"
                android:backgroundTint="@color/white"
                android:background="@drawable/btn_white_border" />
            <CheckBox
                android:id="@+id/checkboxNegotiable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cho phép đề nghị giá"
                android:layout_marginTop="8dp"
                android:textColor="@color/black" />

        </LinearLayout>

        <Button
            android:id="@+id/addItemButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đăng sản phẩm"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:backgroundTint="@color/black"
            android:layout_marginBottom="24dp" />
    </LinearLayout>
</ScrollView>
